{% extends 'base.html.twig' %}
{% block title %}
{% if post %}{{ post.title }}{% else %}Post not found{% endif %}
{% endblock %}
{% block body %}
<div id="single">
    <div class="container">
        {% if not post %}
        <h2>Post not found</h2>
        {% else %}
        <!-- Full Article -->
        <div class="row">
            <h2>{{post.title}}</h2>
            <hr class="subtitle">
            <div class="block1">
                <div class="col-xs-12 col-sm-9">
                    {% if post.image %}
                    <div class="post-image margin-bottom-15">
                        <img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="{{ post.title }}"
                            class="img-responsive">
                    </div>
                    {% endif %}
                    <p>{{ post.content | nl2br }}</p>
                    <h4>- By {{ post.postUser.name }}</h4>
                    <hr>
                    <ul class="list-inline">
                        <li>{{post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }}</li>
                        <li>
                            <a class="page-scroll" href="#form">COMMENT</a>
                            <i class="fa fa-comments sr-icons"></i> {{ post.numComments }} |
                        </li>
                        <li>
                            <a href="{{ path('post_like', {slug: post.slug}) }}" id="like-button">LIKE</a>
                            <i class="fa fa-heart sr-icons"></i>
                            <span id="likes">{{ post.numLikes }}</span>
                        </li>
                    </ul>
                </div>

                <!-- BARRA LATERAL CON LOS POSTS RECIENTES DINÁMICOS -->
                <div class="col-xs-12 col-sm-3">
                    <h4>Recent Post</h4>
                    <hr class="subtitle1">

                    {% for recent in recents %}
                    {{ include('partials/_recent_post.html.twig', {'recent': recent}) }}
                    {% endfor %}
                </div>
            </div>
        </div>
        <!-- End of Full Article -->

        <!-- Comments -->
        <div class="row">
            <div class="col-xs-12 col-sm-12 block2">
                {% for comment in post.comments %}
                <div class="comment {% if loop.index is odd %}alt-comment{% endif %}">
                    <h4>{{comment.name}}</h4>
                    <span>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                        <i class="fa fa-star sr-icons"></i>
                    </span>
                    <p class="time">{{ comment.publishedAt | date('h:i A') }}</p>
                    <hr>
                    <p>{{ comment.text }}</p>
                </div>
                {% endfor %}
                <hr class="line">
                {{ include('partials/_post_comments.html.twig') }}
            </div>
        </div>
        <!-- End of Comments -->
        {% endif %}
    </div>
</div>
<script type='text/javascript'>
    document.addEventListener('DOMContentLoaded', function () {
        const likeLink = document.querySelector('a[href="{{ path('post_like', {slug: post.slug}) }}"]');
        // Hay que coger el id 'likes' para poder cambiar luego el valor al número de likes actual
        const likesSpan = document.querySelector('#likes');
        likeLink.addEventListener('click', function (event) {
            event.preventDefault();
            fetch(likeLink.href, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        likesSpan.innerHTML = " " + data.likes;
                    }
                })
                .catch(error => console.error('Error:', error));
        });
    });
</script>
{% endblock %}